generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  // Anyone can attempt Google sign-in, but a newly auto-created Google
  // account starts unapproved and can't establish a session until an
  // existing user approves it from the Users page. Rows created directly
  // (the Credentials/admin flow, or the create-user script) default to
  // approved since creating one is already an admin-only action.
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FoodItem {
  id           String   @id @default(cuid())
  name         String
  category     String?
  costPrice    Decimal  @db.Decimal(10, 2)
  sellingPrice Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales      Sale[]
  orders     Order[]
  dailyMenus DailyMenu[]
}

model MarketCost {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  quantity    String?
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([date])
}

// Operating expenses (gas, packaging, transportation, etc.) — distinct from
// MarketCost, which is specifically ingredient/supply cost of goods sold.
model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([date])
}

model Sale {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  // Quantity sold — entered directly on the Sales form, independent of
  // Orders. Leftover is derived as quantityMade - quantity.
  quantity    Int      @default(0)
  // Kept for historical rows recorded before quantityMade existed; unused.
  leftover    Int      @default(0)
  // Total tubs made of this item on this date.
  quantityMade Int     @default(0)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  // Explicitly flagged (not inferred from price) so the "Sale" badge stays
  // correct even if the food item's normal price changes later, and a
  // second, sale-flagged row for the same item/date can coexist with a
  // regular one (e.g. today's leftovers sold off at a discount).
  isSale      Boolean  @default(false)
  createdAt   DateTime @default(now())

  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Restrict)

  @@index([date])
}

// Declares which food items are being offered on a given day, independent of
// whether a Sale or MarketCost has been logged yet — the source of truth for
// "what's on the menu today" used by the Sales and Orders food item pickers.
model DailyMenu {
  id         String   @id @default(cuid())
  date       DateTime
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([date, foodItemId])
}

model Order {
  id             String   @id @default(cuid())
  date           DateTime @default(now())
  customerName   String
  quantity       Int
  // Snapshot of the food item's selling price when this order was placed,
  // so a later price change on the food item doesn't retroactively change
  // the total for orders already recorded.
  unitPrice      Decimal  @default(0) @db.Decimal(10, 2)
  // Explicitly flagged (not inferred from price) so the "Sale" badge stays
  // correct even if the food item's normal price changes later.
  isSale         Boolean  @default(false)
  paymentStatus  String   @default("Unpaid")
  deliveryStatus String   @default("Pending")
  paymentMode    String
  createdAt      DateTime @default(now())

  // Shared by every item a customer ordered in one submission, so payment/
  // delivery/mode can be toggled for the whole order at once. Null on rows
  // created before this field existed — those are treated as their own
  // singleton group (keyed by their own id) wherever grouping happens.
  orderGroupId String?

  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Restrict)

  @@index([date])
  @@index([paymentStatus])
  @@index([deliveryStatus])
  @@index([orderGroupId])
}
