# .env is the production database — set it to your production Postgres
# connection string. For local development, create a separate
# .env.development (gitignored, not committed) pointing at a dev/test
# database instead: `next dev`, the Prisma CLI (prisma.config.ts), and
# scripts/create-user.mjs all load .env first and then let
# .env.development override it, so local commands default to dev and
# production is only touched deliberately.

# Postgres connection string (e.g. from Neon or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
# Some providers (e.g. Neon) give a separate non-pooled connection for migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# NextAuth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="..."

# Admin login — users are stored in the User table, not env vars.
# Create or update one with: npm run create-user -- <email> <password> [name]

# Google sign-in (optional) — from a Google Cloud OAuth client
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
# Anyone can attempt to sign in with Google; a new account is created
# unapproved and needs an existing user to approve it from the Users page
# before it can access the app.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
