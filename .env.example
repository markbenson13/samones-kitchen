# Postgres connection string (e.g. from Neon or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Some providers (e.g. Neon) give a separate non-pooled connection for migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with: npx auth secret"

# Single admin login
ADMIN_EMAIL="admin@example.com"
# Generate with: npm run hash-password -- yourPassword
# (the script already escapes the `$` signs for you — paste its output as-is)
ADMIN_PASSWORD_HASH="\$2a\$12\$..."
