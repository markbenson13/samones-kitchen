# Postgres connection string (e.g. from Neon or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
# Some providers (e.g. Neon) give a separate non-pooled connection for migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# NextAuth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="..."

# Admin login — users are stored in the User table, not env vars.
# Create or update one with: npm run create-user -- <email> <password> [name]

# Google sign-in (optional) — from a Google Cloud OAuth client
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails allowed to auto-create a User row on their first
# Google sign-in. An email that already has a User row can always sign in
# with Google, allowlisted or not — this only gates first-time sign-up.
ALLOWED_EMAILS="you@gmail.com,partner@gmail.com"
