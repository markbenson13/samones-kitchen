# Postgres connection string (e.g. from Neon or Vercel Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Some providers (e.g. Neon) give a separate non-pooled connection for migrations
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="..."

# Single admin login
ADMIN_EMAIL="admin@example.com"
# Generate with: npm run hash-password -- yourPassword
# (the script already escapes the `$` signs for you — paste its output as-is
# into a .env file, but when pasting into a host's dashboard like Vercel's,
# strip the backslashes first — that expansion is only needed for Next.js's
# own .env file parser)
ADMIN_PASSWORD_HASH="\$2a\$12\$..."

# Google sign-in (optional) — from a Google Cloud OAuth client
# Authorized redirect URI: <your-app-url>/api/auth/callback/google
# Only ADMIN_EMAIL above is allowed to actually sign in with it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
